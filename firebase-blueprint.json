{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Stores authenticated Indi Labs studio user profile and preferences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["id", "en"],
          "description": "User interface preferred language."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account profile was last updated."
        }
      },
      "required": ["id", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Private user profile accessible strictly by the verified owner."
    }
  }
}
