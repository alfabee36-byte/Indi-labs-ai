rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.id == userId &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage in ['id', 'en'])) &&
        (!('createdAt' in data) || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is string);
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }
  }
}
